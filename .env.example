OPENROUTER_LAYOUT_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Banner Editor Layout Director

# Optional fallback provider.
GEMINI_API_KEY=
GEMINI_LAYOUT_MODEL=gemini-2.5-flash-lite
